[Unit]
Description=SMOCHA — crew hangout hub (Express + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# USER-scope unit — no root needed. Installed to ~/.config/systemd/user/.
WorkingDirectory=/home/dyllan/hangout/server
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target