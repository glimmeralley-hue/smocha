# ─── Required in production — the server fails fast if these are missing ───
# JWT_SECRET: any length, but use >= 32 chars in production.
#   Generate: openssl rand -hex 32
#   Used to derive the AES-256-GCM key that ENCRYPTS every token (JWE).
JWT_SECRET=change-me-to-a-long-random-string
# Crew gate passcode — change from the default before deploying.
CREW_PASSCODE=SMOCHA

# ─── Auth / JWT ───
# Token lifetime (optional, default: 24h). Format: jsonwebtoken-style
# strings are NOT used — jose accepts e.g. "2h", "1d", or a seconds number.
JWT_TTL=24h

# ─── CORS ───
# Comma-separated list of allowed browser origins (default: local dev).
# Same-origin deployments (Express serving the built client) don't need this.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Reverse proxy / real client IP ───
# Number of proxy hops in front of this server, so rate limiting keys on the
# real client IP. 0 = direct internet (no proxy), 1 = one proxy (default in
# production, e.g. Render/Nginx). MUST match your hosting topology.
TRUST_PROXY=0

# ─── Roles / seeding ───
# Comma-separated usernames that get admin role (optional, default: dyllan).
ADMIN_USERNAMES=dyllan
# Seed demo crew on a fresh DB. Defaults to TRUE in dev, FALSE in production.
# Set explicitly to "true" or "false" to force it either way.
SEED_DEMO=true

# ─── Server ───
PORT=5000
# SQLite database path (optional; default: ./data/smocha.db).
# Tests point this at a temp file so they never touch real data.
DB_PATH=

# ─── Logging ───
# dev | info | warn | silent. dev/info log every request (JSON lines);
# warn logs non-2xx only; silent disables request logging.
LOG_LEVEL=dev

# ─── Rate limiting (all optional, in requests per window) ───
# Global API budget per IP (default 200 / 15 min)
RATE_GLOBAL_MAX=200
RATE_GLOBAL_WINDOW_MS=900000
# Auth endpoints — brute-force protection (default 15 / 15 min)
RATE_AUTH_MAX=15
RATE_AUTH_WINDOW_MS=900000
# Per-authenticated-user budget (default 300 / 15 min)
RATE_USER_MAX=300
RATE_USER_WINDOW_MS=900000
# Uploads — disk write protection (default 30 / 15 min)
RATE_UPLOAD_MAX=30
RATE_UPLOAD_WINDOW_MS=900000
# Event feed refresh (default 5 / 15 min)
RATE_REFRESH_MAX=5
# Event import (default 10 / 15 min)
RATE_IMPORT_MAX=10

# ─── Events feed scraper ───
# Set to "false" to disable the outings feed scraper entirely (default: true)
EVENTS_ENABLED=true
# Hours between automatic scrapes (default: 6)
EVENTS_REFRESH_HOURS=6

# Instagram login-wall fix (optional). Paste the `sessionid` cookie from a
# logged-in Instagram browser session (DevTools → Application → Cookies).
# Use a THROWAWAY account — automated access violates IG ToS and the account
# can be banned. Without this, IG scraping works from residential IPs only.
IG_SESSIONID=

# X/Twitter (optional). Used to authenticate oEmbed calls in scrapers/x.js.
X_API_TOKEN=

# TikTok (reserved — not used yet). TikTok's official Research/Display API
# would replace the current import-only path; wire it in scrapers/tiktok.js.
TIKTOK_CLIENT_KEY=
