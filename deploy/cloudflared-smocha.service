[Unit]
Description=Cloudflare Quick Tunnel → SMOCHA on 127.0.0.1:5000
After=network-online.target smocha.service
Wants=network-online.target

[Service]
Type=simple
# USER-scope unit — no root needed. Installed to ~/.config/systemd/user/.
ExecStart=/home/dyllan/.local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:5000
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target